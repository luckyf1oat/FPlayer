<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AIPlayer.MpvHost</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <!-- 修正：原 ILSpy 输出为 net9.0，导致 CsWinRT 的 IAsyncOperation.GetAwaiter 扩展不可见 (CS4036) -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <!-- WinRT.Runtime / Microsoft.Windows.SDK.NET 由 net9.0-windows TFM 隐式提供，
         手工引用会与 CsWinRT 的 WinRTAotSourceGenerator 冲突 (CS0111)，故移除。 -->
    <Reference Include="Microsoft.WinUI">
      <HintPath>..\..\data\player\Microsoft.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\data\player\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="RichasyKernel.Abstractions">
      <HintPath>..\..\data\player\RichasyKernel.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>..\..\data\player\Serilog.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.InteractiveExperiences.Projection">
      <HintPath>..\..\data\player\Microsoft.InteractiveExperiences.Projection.dll</HintPath>
    </Reference>
    <Reference Include="Richasy.WinUIKernel.Share">
      <HintPath>..\..\data\player\Richasy.WinUIKernel.Share.dll</HintPath>
    </Reference>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>..\..\data\player\CommunityToolkit.Mvvm.dll</HintPath>
    </Reference>
    <Reference Include="Richasy.MpvKernel.Core">
      <HintPath>..\..\data\player\Richasy.MpvKernel.Core.dll</HintPath>
    </Reference>
    <Reference Include="Richasy.MpvKernel">
      <HintPath>..\..\data\player\Richasy.MpvKernel.dll</HintPath>
    </Reference>
    <Reference Include="Richasy.MpvKernel.WinUI">
      <HintPath>..\..\data\player\Richasy.MpvKernel.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="FluentResults">
      <HintPath>..\..\data\player\FluentResults.dll</HintPath>
    </Reference>
    <Reference Include="Danmaku.Share">
      <HintPath>..\..\data\player\Danmaku.Share.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>..\..\data\player\System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="Danmaku.Legacy">
      <HintPath>..\..\data\player\Danmaku.Legacy.dll</HintPath>
    </Reference>
    <Reference Include="FluentIcons.WinUI">
      <HintPath>..\..\data\player\FluentIcons.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="FluentIcons.Common">
      <HintPath>..\..\data\player\FluentIcons.Common.dll</HintPath>
    </Reference>
    <Reference Include="RichasyKernel.Core">
      <HintPath>..\..\data\player\RichasyKernel.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>..\..\data\player\Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Sinks.File">
      <HintPath>..\..\data\player\Serilog.Sinks.File.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging">
      <HintPath>..\..\data\player\Microsoft.Extensions.Logging.dll</HintPath>
    </Reference>
    <Reference Include="WinUIEx">
      <HintPath>..\..\data\player\WinUIEx.dll</HintPath>
    </Reference>
    <Reference Include="CommunityToolkit.WinUI.Controls.Sizers">
      <HintPath>..\..\data\player\CommunityToolkit.WinUI.Controls.Sizers.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Extensions.Logging">
      <HintPath>..\..\data\player\Serilog.Extensions.Logging.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>