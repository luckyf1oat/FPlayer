<?xml version="1.0" encoding="utf-8"?>
<!--
  ===== t26 / U-A：外壳新 UI 全局框架（HillsLite 风格）=====
  权威 = shell/docs/UI_SPEC_SHELL.md §2 布局 / §3 侧栏：
    侧栏固定 256（§1 实测）｜顶栏常驻搜索框 320×36 **按内容区居中**（不是窗口居中）｜内容区拉伸
  令牌全部取自 Theme/Tokens.xaml（t26 独占维护；ui2 只消费）。
-->
<Window
    x:Class="AIPlayer.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI">

    <!-- t26 补遗①（captain 2026-09-11 授权，并入 t34）：根节点钉暗色主题。
         否则系统为浅色时，令牌硬编码的深色面正确、但 ThemeResource 驱动的面会被渲染成浅色
         （实测：占位页卡片 CardBackgroundFillColorDefaultBrush 叠 #222222 呈 #BDBDBD、
          搜索框 PlaceholderText 深字压深底）。 -->
    <Grid x:Name="RootGrid" Background="{StaticResource PageBgBrush}" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 侧栏（#202020，固定 256） ================= -->
        <Grid Grid.Column="0" Background="{StaticResource RailBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo + 返回（§3） -->
            <Grid Grid.Row="0" Height="52" Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RailBackButton" Grid.Column="0" Click="RailBack_Click" Padding="6" Background="Transparent" BorderThickness="0" IsEnabled="False">
                    <ic:SymbolIcon Symbol="ArrowLeft" IconVariant="Filled" Foreground="{StaticResource TextPrimaryBrush}" />
                </Button>
                <TextBlock Grid.Column="1" Text="AI Player" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
            </Grid>

            <!-- 导航四项：首页 / 收藏 / 媒体库 / 聚合视界（§3；用户 2026-09-12 报障第⑤条：缺「媒体库」） -->
            <ListBox x:Name="RailNavList" Grid.Row="1" Margin="8,4,8,8" Background="Transparent" BorderThickness="0"
                     SelectionChanged="RailNav_SelectionChanged" Tapped="RailNav_Tapped">
                <ListBoxItem Tag="home" Content="首页" MinHeight="44" />
                <ListBoxItem Tag="favorites" Content="收藏" MinHeight="44" />
                <ListBoxItem Tag="library" Content="媒体库" MinHeight="44" />
                <ListBoxItem Tag="aggregate" Content="聚合视界" MinHeight="44" />
            </ListBox>

            <!-- 分组标题：服务器 + 齿轮（§3） -->
            <Grid Grid.Row="2" Padding="16,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="服务器" VerticalAlignment="Center" Style="{StaticResource RailHeaderTextStyle}" />
                <Button Grid.Column="1" Click="ServerManage_Click" Padding="6" Background="Transparent" BorderThickness="0">
                    <ic:SymbolIcon Symbol="Settings" IconVariant="Filled" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- 服务器列表：行高 52、紫左条 3px、绿菱形 28、名称、拖拽手柄、第二行「N 天前看过」（§3） -->
            <ListView x:Name="ServerList" Grid.Row="3" Margin="0,0,0,4"
                      Background="Transparent" BorderThickness="0"
                      SelectionMode="Single"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                      DragItemsCompleted="ServerList_DragItemsCompleted"
                      ContextRequested="ServerList_ContextRequested"
                      SelectionChanged="ServerList_SelectionChanged"
                      Tapped="ServerList_Tapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="52" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 选中态紫左条（3px，§3 x=4..6） -->
                            <Border Grid.Column="0" Width="3" Background="{StaticResource AccentBrush}"
                                    Visibility="{Binding AccentBarVisibility}" />
                            <!-- 服务器图标 28（**用户 2026-09-12 裁定**：显示 Emby 图标，不要纯色大方块）。
                                 状态仍可见 = 2px 状态色描边（`StatusBrush`：绿=连通 / 粉=失败），不额外占版面。
                                 图标来源 = **原版资产** `data/flutter_assets/assets/icons/emby.png`（512×423）降采样 64×64
                                 ⇒ `shell/App/Assets/Icons/emby.png`（2,094 B / sha12 `3B716E0B523B`，由 captain 生成并入库）。 -->
                            <Grid Grid.Column="1" Width="28" Height="28" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Image Width="24" Height="24" Stretch="Uniform" Source="{Binding IconSource}" />
                                <Border Width="28" Height="28" CornerRadius="4" BorderThickness="2"
                                        BorderBrush="{Binding StatusBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AgeText}" Style="{StaticResource ServerAgeTextStyle}" />
                            </StackPanel>
                            <!-- 拖拽手柄 §3 x=233..244。§1.1：禁止文本符号当图标 ⇒ 由 `<TextBlock Text="=">` 改为图标控件。
                                 SymbolIcon 走**成员名**（比码位可维护）：Symbol="LineHorizontal3"。
                                 候选取自 FluentIcons.Common 1.1.292（Symbol 枚举 2610 成员，反射取全表实测）；
                                 已按纪律用逐行像素剖面确认非空心方框（见 HANDLE-PROFILE 证据）。
                                 颜色仍走 HandleBrush（只读行 = TextDisabledBrush 灰），tooltip 仍走 HandleToolTip。 -->
                            <ic:SymbolIcon Grid.Column="3" Symbol="LineHorizontal3" IconVariant="Regular" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding HandleToolTip}"
                                           Foreground="{Binding HandleBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 底部：添加服务器(+) / 设置(⚙)（§3；**无** Pro/账号项） -->
            <StackPanel Grid.Row="4" Padding="8,4,8,12">
                <Button x:Name="AddServerButton" Click="AddServer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,10" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ic:SymbolIcon Symbol="Add" IconVariant="Filled" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="添加服务器" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Click="Settings_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,10" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ic:SymbolIcon Symbol="Settings" IconVariant="Filled" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="设置" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 内容区（自 x=256 起，拉伸） ================= -->
        <Grid Grid.Column="1" Background="{StaticResource PageBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：搜索框 320×36 **按内容区居中**（§2/§7.2） -->
            <Grid Grid.Row="0" Height="48" Background="{StaticResource PageBgBrush}">
                <Border x:Name="SearchBox" Width="320" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource ControlBgBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ic:SymbolIcon Grid.Column="0" Symbol="Search" IconVariant="Filled" Margin="10,0,6,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox x:Name="SearchInput" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 PlaceholderText="搜索" VerticalAlignment="Center" GotFocus="SearchInput_GotFocus" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
                        <Button x:Name="SearchClearButton" Grid.Column="2" Click="SearchClear_Click" Padding="6" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0">
                            <ic:SymbolIcon Symbol="Dismiss" IconVariant="Filled" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" />

            <!-- 状态中枢可视面（保留 t8 的可运行证据面：路由 / 服务器数 / 日志条数） -->
            <Border Grid.Row="2" Padding="12,4" Background="{StaticResource PageBgBrush}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RouteText" Grid.Column="0" Style="{StaticResource ServerAgeTextStyle}" />
                    <TextBlock x:Name="ServersText" Grid.Column="1" Style="{StaticResource ServerAgeTextStyle}" />
                    <TextBlock x:Name="LogsText" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ServerAgeTextStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
