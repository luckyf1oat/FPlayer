<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AIPlayer.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Richasy.WinUIKernel.Share.Converters">
    <!--
      应用级资源（一次做全）。
      依据：
        · 7 个转换器键名 = DESIGN §7.3 第 6 条权威表（来源：内核 App.strings.txt 索引 7/9/10/11/12/13/14）
          ⚠️ Reverse 变体是**独立键名**，不是「同键 + 参数」
        · 5 个样式键 = 同表（索引 15/17/18/19/20）
        · 内核 PlayerOverlay 的绑定在运行时用 ResourceDictionary 查这些键
          （PlayerOverlay.cs:475 LookupConverter / :526 BoolToVisibilityConverter / :575 BoolToIconVariantConverter）
        · 这批资源在 Spike 阶段缺失过一次，导致浮层绑定抛 COMException 0x80004005 ⇒ 此处补齐
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                  t26 / U-A：新 UI 令牌表（HillsLite 风格）。t26(ui) 独占维护；ui2 只消费不修改。
                  放在应用级 ⇒ 任意 Page 都能 {StaticResource RailBgBrush} 等直接取用。
                -->
                <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 转换器（7） ===== -->
            <conv:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter" />
            <conv:BoolToVisibilityConverter   x:Key="BoolToVisibilityReverseConverter" IsReverse="True" />
            <conv:ObjectToBoolConverter       x:Key="ObjectToBoolConverter" />
            <conv:ObjectToBoolConverter       x:Key="ObjectToBoolReverseConverter" IsReverse="True" />
            <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
            <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibilityReverseConverter" IsReverse="True" />
            <conv:BoolToIconVariantConverter  x:Key="BoolToIconVariantConverter" />

            <!-- ===== 样式键（5）：外壳自建等价物 ===== -->
            <Style x:Key="DefaultButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style x:Key="SmallIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
            <Style x:Key="PageProgressRingStyle" TargetType="ProgressRing">
                <Setter Property="IsActive" Value="True" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
