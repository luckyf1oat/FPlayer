<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AIPlayer.Shell.Features.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="媒体库" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" Text="" />
        </StackPanel>

        <ListView
            x:Name="ViewList"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,12,0"
            SelectionMode="Single"
            SelectionChanged="ViewList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="0,6,0,6" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <GridView
            x:Name="ItemGrid"
            Grid.Row="1"
            Grid.Column="1"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="ItemGrid_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="8">
                        <!-- 尺寸契约：150x225（2:3），与 LibraryPage.xaml.cs 的 CardWidth/CardHeight 同值（改一处必须改两处） -->
                        <Grid Width="150" Height="225">
                            <!-- 占位底色：图没到之前就是这个底（与详情页同色 #333333） -->
                            <Border CornerRadius="8" Background="#FF333333" />
                            <!-- t292（B）：摆法按条目类型定 —— 2:3 原生素材 UniformToFill（填满）；
                                 16:9 / 1:1 素材 Uniform（留边不裁，不把横图硬塞进竖框）。默认值即旧行为。 -->
                            <Image Source="{Binding Image}" Stretch="{Binding ImageStretch}" />
                            <!-- 角标（t77②「集数徽标」）：文本为空时整块 Collapsed，不画空框 -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                    Background="#CC000000" CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
