<?xml version="1.0" encoding="utf-8"?>
<!--
  ===== 屏 A：添加服务器（t30 / U-D）=====
  规格 = shell/docs/UI_SPEC_SHELL.md §8（居中模态 + 背景压暗 + 标题「添加服务器」+ 五字段 + 取消/登录）
  参照实测 = shell/docs/HILLSLITE_UI_ANALYSIS.md §4.3（字段占位与必填性逐条）

  字段与落点：
    类型(Kind) → ServerConfig.Kind   ★[设计] 与参照物的有意偏离：参照物只有视频源，我们还有 Navidrome/ABS/WebDAV
    显示名称   → ServerConfig.Name          选填（登录成功后自动获取）
    服务器地址 → ServerConfig.BaseUrl       必填（归一化：容纳「地址」与「地址+端口」两形态）
    端口       → 拼进 BaseUrl（不新增字段） 选填
    根路径     → Extra["rootPath"]          仅 WebDAV 显示
    用户名     → ServerConfig.UserName       必填（五类都对凭据有要求）
    密码       → PasswordStore（DPAPI 密文，绝不进 JsonStorage）
  🔴 令牌只用 Theme/Tokens.xaml 已有的键。
-->
<ContentDialog
    x:Class="AIPlayer.Shell.Features.Servers.AddServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加服务器"
    PrimaryButtonText="登录"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Width="440" Spacing="10">
            <ComboBox x:Name="KindBox" Header="类型" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged" />

            <TextBox x:Name="NameBox" Header="显示名称" PlaceholderText="选填（登录成功后自动获取）" />
            <TextBox x:Name="UrlBox" Header="服务器地址" PlaceholderText="https://emby.example.com（必填）" TextChanged="OnUrlOrPortChanged" />
            <TextBox x:Name="PortBox" Header="端口" PlaceholderText="选填；地址里已带端口时留空" TextChanged="OnUrlOrPortChanged" />
            <TextBox x:Name="RootPathBox" Header="根路径" PlaceholderText="选填（默认用地址里的路径，例如 /dav）" Visibility="Collapsed" />
            <TextBox x:Name="UserBox" Header="用户名" PlaceholderText="必填" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PassBox" Grid.Column="0" Header="密码" PlaceholderText="选填（兼容空口令账号）" />
                <TextBox x:Name="PassPlain" Grid.Column="0" Header="密码" Visibility="Collapsed" />
                <ToggleButton x:Name="RevealButton" Grid.Column="1" Content="显示"
                              VerticalAlignment="Bottom" MinWidth="64" Click="OnRevealClick" />
            </Grid>

            <!-- 校验/失败提示（§8「地址自带校验」）：可达但认证失败与连不上必须能区分 -->
            <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource ServerFailBrush}" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
