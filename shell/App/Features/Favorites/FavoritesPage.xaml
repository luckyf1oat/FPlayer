<?xml version="1.0" encoding="utf-8"?>
<!--
  ===== 收藏屏（t31 / U-E）=====
  规格 = shell/docs/HILLSLITE_UI_ANALYSIS.md §2 行 2（参照图 `hl-02-favorites-printwindow.png`，已人眼核对）：
         **两个分区**：`收藏的剧`（7 张海报）/ `收藏的季`（1 张）；分区标题带 `›`；
         海报**右上角紫色圆形数字徽章**（4/4/4/3/21/12…）= **未看集数**（§4.5「单帧放大判读」：数字 = 未看集数、`✓` = 已看完）；
         海报下方 = 标题 + 年份区间（如 `2024-现在` / `2026`）。
       + UI_SPEC_SHELL.md §3「侧栏第二项收藏」/ §6.1「收藏 ♡ 绑定 SetFavoriteAsync」/ §10 P4「空源占位不崩」。

  令牌纪律：颜色只用 Theme/Tokens.xaml 的键；占位底 `#FF333333` 为 HILLSLITE §4.5 实测值。
-->
<Page
    x:Class="AIPlayer.Shell.Features.Favorites.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PageBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="收藏" FontSize="20" FontWeight="SemiBold" Margin="16,14,16,6"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <!-- 摘要：台数 / 有收藏台数 / 失败台数 / 总数（四个数各自具名，不写"一致"） -->
        <StackPanel Grid.Row="1" Spacing="3" Margin="16,0,16,10">
            <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="FailedText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource ServerFailBrush}" />
            <!-- t87：收藏是完整列表 ⇒ 屏上不是全部时必须可见（禁止静默截断） -->
            <TextBlock x:Name="MoreText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 两个分区：每区 = 标题（带 ›）+ 一行海报 -->
                <ItemsControl x:Name="SectionList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <GridView ItemsSource="{Binding Posters}"
                                          Visibility="{Binding ItemsVisibility}"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="190" ItemHeight="300" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0,0,24,0" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="166" Spacing="6">
                                                <Grid Width="166" Height="249" CornerRadius="12">
                                                    <!-- 占位底（HILLSLITE §4.5 实测 #333333） -->
                                                    <Border Background="#FF333333" CornerRadius="12"
                                                            Visibility="{Binding PlaceholderVisibility}" />
                                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding PlaceholderVisibility}" />
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />

                                                    <!-- [!] 未看集数角标：海报**右上角紫色圆形徽章**（数字 / ✓） -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,6,6,0" MinWidth="22" Height="22"
                                                            CornerRadius="11"
                                                            Background="{StaticResource AccentBrush}"
                                                            Visibility="{Binding BadgeVisibility}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="12" Margin="6,0"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#FF202020" />
                                                    </Border>

                                                    <!-- 来源服务器角标（左下）：跨服收藏必须看得出东西是哪来的 -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="6,0,0,6" MinHeight="20" CornerRadius="10" Padding="8,2"
                                                            Background="#B3000000"
                                                            Visibility="{Binding SourceBadgeVisibility}">
                                                        <TextBlock Text="{Binding SourceName}" FontSize="11"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Border>

                                                    <!-- 取消收藏（左下第二位，避免与角标抢右上角） -->
                                                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0"
                                                            MinWidth="30" Height="30" Padding="0" CornerRadius="15"
                                                            Background="#B3000000" BorderThickness="0"
                                                            Content="{Binding FavoriteGlyph}"
                                                            ToolTipService.ToolTip="{Binding FavoriteTooltip}"
                                                            Click="OnUnfavoriteClick" />

                                                    <!-- t103：**显式播放入口**（点卡片 = 进详情页；起播走这里） -->
                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                                            MinWidth="30" Height="30" Padding="0" CornerRadius="15"
                                                            Background="#B3000000" BorderThickness="0" FontSize="12"
                                                            Content="{Binding PlayGlyph}"
                                                            ToolTipService.ToolTip="{Binding PlayTooltip}"
                                                            Click="OnPlayClick" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="14" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <TextBlock Text="{Binding EmptyText}" FontSize="12" Margin="0,0,0,6"
                                           Visibility="{Binding EmptyVisibility}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FailText}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="{Binding FailVisibility}"
                                           Foreground="{StaticResource ServerFailBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="LoadingText" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyDetail" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
