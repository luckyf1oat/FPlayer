<?xml version="1.0" encoding="utf-8"?>
<!--
  ===== 聚合视界屏（t31 / U-E）=====
  规格 = shell/docs/HILLSLITE_UI_ANALYSIS.md §2 行 3 / §3 行 5：
         顶部三个过滤标签 `▶ 继续播放` / `♡ 收藏` / `▤ 媒体库`；下面**按服务器分组**（每组一行海报）；
         每张海报下**一条进度条**；无封面的源显示**灰底 + 胶片图标占位**。
        `UI_SPEC_SHELL.md` §10 P4 判据：**跨服分组 + 进度条；空源显示占位图不崩**。

  令牌纪律：颜色只用 Theme/Tokens.xaml 的键。
  唯一例外 = 海报占位底 `#FF333333`（HILLSLITE §4.5 实测：参照物无封面就是 `#333333` 占位卡），
  Tokens.xaml 现无此键 ⇒ 就地标注（与 SearchPage 同处置，已请 ui 追加 PlaceholderBgColor）。
-->
<Page
    x:Class="AIPlayer.Shell.Features.Aggregate.AggregatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PageBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部三个过滤器（参照物：三个标签；选中态 = 强调底）===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="16,12,16,4">
            <StackPanel.Resources>
                <Style x:Key="FilterButtonStyle" TargetType="Button">
                    <Setter Property="MinHeight" Value="33" />
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Background" Value="{StaticResource ControlBgBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </StackPanel.Resources>
            <Button x:Name="ContinueFilterButton" Content="▶ 继续播放" Tag="ContinueWatching"
                    Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
            <Button x:Name="FavoritesFilterButton" Content="♡ 收藏" Tag="Favorites"
                    Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
            <Button x:Name="LibraryFilterButton" Content="▤ 媒体库" Tag="Library"
                    Style="{StaticResource FilterButtonStyle}" Click="OnFilterClick" />
        </StackPanel>

        <!-- 摘要行：成功源数 / 条目数 / 失败源逐个点名（§7.6 同纪律：三个数各自指名，不写"一致"） -->
        <StackPanel Grid.Row="1" Spacing="3" Margin="16,0,16,10">
            <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="FailedText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource ServerFailBrush}" />
            <!-- 未取尽/撞硬上限的可见提示（t291）：文案单点 = MediaSnapshotSource.TruncationNotice
                 （与收藏屏同一口径）。屏上条数 < 服务端总数、或撞上每源硬上限时必须看得见。 -->
            <TextBlock x:Name="NoticeText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- ===== 分组列表：每组 = 服务器名 + 一行海报 ===== -->
        <ScrollViewer Grid.Row="2" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="GroupList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FailText}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="{Binding FailVisibility}"
                                           Foreground="{StaticResource ServerFailBrush}" />
                                <TextBlock Text="{Binding EmptyText}" FontSize="12" Margin="0,0,0,6"
                                           Visibility="{Binding EmptyVisibility}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <GridView ItemsSource="{Binding Posters}"
                                          Visibility="{Binding ItemsVisibility}"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="190" ItemHeight="300" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0,0,24,0" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="166" Spacing="6">
                                                <Grid Width="166" Height="249" CornerRadius="12">
                                                    <!-- 占位底（HILLSLITE §4.5 实测 #333333）；无封面时可见 -->
                                                    <Border Background="#FF333333" CornerRadius="12"
                                                            Visibility="{Binding PlaceholderVisibility}" />
                                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding PlaceholderVisibility}" />
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                    <!-- 进度条（参照物：每张海报下一条；仅"继续播放/库"族画） -->
                                                    <Border VerticalAlignment="Bottom" Height="8" Background="#66000000"
                                                            CornerRadius="0,0,12,12"
                                                            Visibility="{Binding ProgressVisibility}">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Border HorizontalAlignment="Left" Height="8"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    Width="{Binding ProgressWidth}" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- t103：**显式播放入口**（点卡片 = 进详情页；起播走这里） -->
                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,12"
                                                            MinWidth="30" Height="30" Padding="0" CornerRadius="15"
                                                            Background="#B3000000" BorderThickness="0" FontSize="12"
                                                            Content="{Binding PlayGlyph}"
                                                            ToolTipService.ToolTip="{Binding PlayTooltip}"
                                                            Click="OnPlayClick" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="14" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 加载态 -->
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="LoadingText" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 空态（无任何可用源 / 三过滤皆空） -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyDetail" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
